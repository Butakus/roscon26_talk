// VS Code: "Dev Containers: Reopen in Container" with this folder open
// (or "Open Folder in Container" on demos/02_containers).
{
  "name": "EasyNav dev (ROS 2 rolling)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../../..",
    "args": { "ROS_DISTRO": "rolling" }
  },
  // Mount the whole repository: the demo needs common/ as well
  "workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspaces/roscon26_talk,type=bind",
  "workspaceFolder": "/workspaces/roscon26_talk/demos/02_containers",
  "remoteUser": "ubuntu",
  "runArgs": [
    "--network=host",
    "--ipc=host"
    // Podman rootless: also add "--userns=keep-id"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python",
        "ms-iot.vscode-ros"
      ],
      "settings": {
        // compile_commands.json is generated by colcon (common/colcon_defaults.yaml)
        "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/build"]
      }
    }
  },
  "postCreateCommand": "mkdir -p src && vcs import --skip-existing --input ../../common/easynav.repos src"
}
